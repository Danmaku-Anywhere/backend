{
  "name": "@danmaku-anywhere/backend",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "author": "Mr-Quin",
  "repository": "https://github.com/Danmaku-Anywhere/backend",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "pnpm dev --remote",
    "test": "vitest run",
    "lint": "biome check --fix",
    "lint:ci": "biome ci",
    "type-check": "tsgo --noEmit",
    "cf-typegen": "wrangler types",
    "wrangler": "wrangler",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "drizzle": "drizzle-kit",
    "drizzle:generate": "drizzle-kit generate --config drizzle.config.ts",
    "drizzle:push:prod": "drizzle-kit push --config drizzle.config.ts",
    "better-auth:generate": "pnpx @better-auth/cli@latest generate",
    "db:migrate:local": "pnpm wrangler d1 migrations apply danmaku-anywhere-db-staging --env staging --local",
    "db:migrate:staging": "pnpm wrangler d1 migrations apply danmaku-anywhere-db-staging --env staging",
    "db:migrate:prod": "pnpm wrangler d1 migrations apply danmaku-anywhere-db --env production",
    "prepare": "lefthook install",
    "fallow": "3.49.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@types/node": "^26.6.11",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "fallow": "3.49.0",
    "lefthook": "^2.2.4",
    "typescript": "^7.0.2",
    "vitest": "5.1.2",
    "wrangler": "^4.168.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "@danmaku-anywhere/integration-policy": "^0.1.1",
    "@google/generative-ai": "^0.24.1",
    "@hono/standard-validator": "^0.4.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.12.26",
    "@sentry/cloudflare": "^11.19.0",
    "better-auth": "^1.7.28",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "hono-openapi": "^1.6.0",
    "resend": "^6.40.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.2.2"
}
